# Required. Get one at https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# Optional — defaults shown. Any OpenRouter model id works (https://openrouter.ai/models);
# the main model must support tool calling for web search.
# DOSSIER_MODEL=anthropic/claude-sonnet-5
# DOSSIER_FAST_MODEL=anthropic/claude-haiku-4.5
# DOSSIER_WEB_SEARCH=on

# --- Auth (Supabase) ------------------------------------------------------
# Both required to turn auth on. Without them the app runs unauthenticated in
# development, and refuses every API request in a production build.
# Find them under Project Settings -> API keys in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Older projects issue an anon key instead; either name works.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Comma-separated allowlist of addresses that may sign in. Strongly recommended:
# without it anyone who can create a Supabase account can spend your OpenRouter credits.
DOSSIER_ALLOWED_EMAILS=
