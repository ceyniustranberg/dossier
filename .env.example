# Used only by the board's own Dig deeper and Find images buttons (and the find_images MCP tool).
# The user's agent does the main research with its own tools. Get one at https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# Optional — defaults shown. Any OpenRouter model id works (https://openrouter.ai/models);
# the main model must support tool calling for web search.
# DOSSIER_MODEL=anthropic/claude-sonnet-5
# DOSSIER_FAST_MODEL=anthropic/claude-haiku-4.5
# DOSSIER_WEB_SEARCH=on

# --- Auth (Supabase) ------------------------------------------------------
# Both required to turn auth on. Without them the app runs unauthenticated in
# development, and refuses every API request in a production build.
# Find them under Project Settings -> API keys in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Older projects issue an anon key instead; either name works.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Required: the server-only secret key (sb_secret_…), same page. Dossiers, cards and API
# tokens live in tables that only this key can read. Never give it a NEXT_PUBLIC_ name.
SUPABASE_SECRET_KEY=

# The public URL agents connect to and dossier links point at. Defaults to the request's origin.
# NEXT_PUBLIC_SITE_URL=https://dossier.example.com

# Set to "off" to skip sign-in while testing locally with `npm run dev`.
# Ignored in production builds.
# DOSSIER_AUTH=off

# Comma-separated allowlist of addresses that may sign in and get an MCP token. Required in
# production: a production build with an empty list lets nobody in.
DOSSIER_ALLOWED_EMAILS=
